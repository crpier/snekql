@@ -0,0 +1,10 @@
+"""MariaDB counter declaration without an implicit concurrency policy."""
+
+from snekql import mariadb as db
+
+
+class Counter[S = db.Pending](db.Model[S, "Counter[db.Fetched]"]):
+    __tablename__ = "counter"
