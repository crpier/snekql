"""Hand-authored typed data work against generated historical declarations."""

from snekql import BACKEND as db
from snekql.experimental import migrations as m
from historical import Historical as Accounts, CONTRACT_DIGEST

CHANGES = (
    m.DataChange.from_query(
        db.update(Accounts)
        .set(Accounts.role.to("admin"))
        .where(Accounts.is_admin.eq(True)),
        checkpoint="fill_roles",
        contract_digest=CONTRACT_DIGEST,
    ),
    m.DataChange.from_query(
        db.update(Accounts)
        .set(Accounts.role.to("user"))
        .where(Accounts.is_admin.eq(False)),
        checkpoint="fill_roles",
        contract_digest=CONTRACT_DIGEST,
    ),
)
