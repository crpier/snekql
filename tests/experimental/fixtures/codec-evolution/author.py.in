"""Author frozen v1 bindings; current models will later import a different codec."""

import json
from pathlib import Path

from models import Account, Expanded, Initial
from role_codec import EPOCH

from snekql import BACKEND as db
from snekql.experimental import migrations as m

first = m.compile(m.generate("001_accounts", [Initial], backend="BACKEND"))
expansion = m.generate("002_roles", [Expanded], backend="BACKEND", previous=first).then(
    m.Checkpoint(name="fill_roles")
)
try:
    m.contract_source(expansion, point="fill_roles", table="accounts")
except m.PackageError as error:
    assert "explicit codec" in str(error)
else:
    raise AssertionError("opaque historical codec was silently reconstructed")
# Explicit author-owned historical model with v1 codec; no generated-codec inference.
digest = m.contract_digest(expansion, point="fill_roles")
route = expansion.then(
    m.DataChange.from_query(
        db.update(Expanded)
        .set(Expanded.role.to(True))
        .where(Expanded.is_admin.eq(True)),
        checkpoint="fill_roles",
        contract_digest=digest,
    ),
    m.DataChange.from_query(
        db.update(Expanded)
        .set(Expanded.role.to(False))
        .where(Expanded.is_admin.eq(False)),
        checkpoint="fill_roles",
        contract_digest=digest,
    ),
).advance(
    [Account], removals=(m.DropColumn(table_name="accounts", column_name="is_admin"),)
)
package = m.compile(route)
if __name__ == "__main__":
    Path("001_accounts.json").write_text(first.dump())
    Path("002_roles.json").write_text(package.dump())
    print(
        json.dumps(
            {"epoch": EPOCH, "digest": package.digest, "bindings": package.bindings}
        )
    )
