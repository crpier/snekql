"""Model/codec-free execution of frozen packages, with physical wire observations."""

import asyncio
import json
import sys
from pathlib import Path

from snekql import BACKEND as db
from snekql.experimental import migrations as m


async def main() -> None:
    """Historical deployment must bind stored primitives, not run today's codec."""
    payload = json.loads(sys.stdin.read())
    config = CONFIG
    if payload["action"] == "seed":
        async with await db.Database.initialize(config) as app, app.transaction() as tx:
            await tx.execute(
                db.raw("INSERT INTO accounts(id,is_admin) VALUES(1,1),(2,0)")
            )
        return
    text = Path(payload["package"]).read_text()
    package = m.Package.load(text)
    async with m.connect(config) as target:
        outcome = await target.apply(
            await target.prepare(package, schema_writers_excluded=NATIVE)
        )
        again = await target.apply(
            await target.prepare(package, schema_writers_excluded=NATIVE)
        )
        progress = sorted(
            (p.revision, p.phase, p.digest) for p in await target.status()
        )
    wire = []
    if package.draft.revision != "001_accounts":
        async with await db.Database.initialize(config) as app, app.transaction() as tx:
            wire = await tx.fetch_all(
                db.raw("SELECT id,role FROM accounts ORDER BY id")
            )
    assert not {"models", "author", "role_codec", "evolve"} & sys.modules.keys()
    assert package.dump() == text
    print(
        json.dumps(
            {
                "outcome": outcome,
                "again": again,
                "progress": progress,
                "wire": wire,
                "digest": package.digest,
                "lazy_imports": sys.get_lazy_imports(),
            }
        )
    )


asyncio.run(main())
