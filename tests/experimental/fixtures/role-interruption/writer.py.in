"""An ordinary unrelated application writer has no migration-lock protocol."""

import asyncio
import json
import sys
from pathlib import Path
from typing import ClassVar

from snekql import BACKEND as db


class Audit[S = db.Pending](db.Model[S]):
    """Query mapping does not grant migration ownership of this external table."""

    __tablename__ = "audit_log"
    __row_type__: ClassVar[db.ReadType[Audit[db.Row]]]
    id: db.Col[int] = db.Integer(primary_key=True)


async def main() -> None:
    """Write through ordinary typed application queries while a migrator is blocked."""
    payload = json.loads(sys.stdin.read())
    config = CONFIG
    async with await db.Database.initialize(config) as app, app.transaction() as tx:
        await tx.execute(db.insert(Audit(id=42)))
    print(json.dumps({"written": 42}))


asyncio.run(main())
